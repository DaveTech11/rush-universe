# Get this from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# ---- Drops feature ----
# Chat where drops get posted (channel/group). Use @channelusername or a numeric -100... id
TELEGRAM_CHAT_ID=1004310141178

# ---- Gateway (optional — leave blank to disable either requirement) ----
# One or more Telegram channels users must join before using the bot at all
# (comma-separated). Bot must be an admin of each. Single-channel var still works too.
GATEWAY_CHANNELS=@linkbydave,@missariapapers
GATEWAY_CHANNEL=@MissAriaSupport,@rushbydave

# WhatsApp group link shown at the gate + on the WhatsApp task.
# NOTE: there is no API to verify WhatsApp membership — this step is self-reported by the user.
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/DUVXtp7By61FH1w8xEuA92?s=cl&p=a&mlu=4
# Optional image shown on the gateway screen
GATEWAY_IMAGE_URL=https://files.catbox.moe/xtixno.jpg

# Chat (your own DM with the bot, or an admin group) where WhatsApp screenshot
# submissions get forwarded for a manual Approve/Reject.
ADMIN_REVIEW_CHAT_ID=7724436551,7161177100

# ---- Admin web panel ----
ADMIN_USER=admin
ADMIN_PASSWORD=davetech
PORT=3000

# ---- Gamification ----
# Auto-created rotating jackpot. Games award free tickets.
JACKPOT_POINTS=1000
JACKPOT_HOURS=24

# Public URL Railway gives you (only needed if you switch to webhook mode)
PUBLIC_URL=

# Optional image used on the main menu and war menus
MENU_IMAGE_URL=https://files.catbox.moe/xtixno.jpg
WAR_MENU_IMAGE_URL=https://files.catbox.moe/14o2wk.jpg
# Optional image shown on the Games menu
GAMES_MENU_IMAGE_URL=https://files.catbox.moe/5fdi0h.png

# ---- Game winner channel ----
# Channel/group where every game winner gets a public CLAIM / LEAVE post.
# Bot must be able to post messages there.
GAME_WIN_CHANNEL_ID=@linkbydave
# Points awarded when the winner taps CLAIM.
GAME_WIN_CLAIM_POINTS=25

# ---- Telegram admin / high-point player gifts ----
# Comma-separated Telegram user IDs allowed to use /admin, /vipusers, /gift and /giftpoints.
ADMIN_USER_IDS=7724436551,7161177100
# Players at or above this point total appear in the admin high-point list.
ADMIN_HIGH_POINTS=1000

# ---- RUSH Wallet / Store ----
# Points are virtual in-bot currency. Cash-out requests require admin review.
# MENU_IMAGE_URL can be used for the main menu image.

# Render persistent disk mount path (set this to /var/data on Render)
DATA_DIR=/var/data
HOST=0.0.0.0

# Optional public health URL used to keep the Render web service active
# If omitted on Render, RENDER_EXTERNAL_HOSTNAME is used automatically.
KEEPALIVE_URL=

# Start RUSH in maintenance mode (admins can still use the bot)
MAINTENANCE_MODE=false
